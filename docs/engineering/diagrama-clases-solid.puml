' catalog
' =====================================================================
package "catalog" {

  package "controllers" {
    class "catalog.controller::CatalogController" as CC {
      - VaccineService service
      - EffectiveCatalogService effective
    }
    class "catalog.controller::InstitutionCatalogController" as ICC {
      - InstitutionVaccineService service
    }
    class "catalog.controller::GeoCatalogController" as GCC {
      - GeoCatalogService service
    }
    class "catalog.controller::ReferenceCatalogController" as RCC {
      - ReferenceCatalogService service
    }
  }

  package "services" {
    class "catalog.service::VaccineService" as VS <<service>> {
      - VaccineRepository vaccines
      - VaccineOptionRepository options
      - VaccineOptionTemplateRepository templates
      - PermissionGuard guard
      - CatalogMapper mapper
    }
    class "catalog.service::InstitutionVaccineService" as IVS <<service>> {
      - InstitutionVaccineRepository relations
      - InstitutionVaccineOptionRepository local
      - VaccineRepository vaccines
      - VaccineOptionTemplateRepository templates
      - DataScope / PermissionGuard / CatalogMapper
    }
    class "catalog.service::CatalogSelectionService" as CSS <<service>> {
      - VaccineRepository vaccines
      - VaccineOptionRepository vaccineOptions
      - InstitutionVaccineRepository institutionVaccines
      - InstitutionVaccineOptionRepository institutionOptions
      + resolve(ResolutionRequest) : DoseSelection
    }
    class "catalog.service::EffectiveCatalogService" as ECS <<service>> {
      - InstitutionVaccineRepository institutionVaccines
      - InstitutionVaccineOptionRepository institutionOptions
      - VaccineRepository vaccines
      - VaccineOptionRepository vaccineOptions
      - IdentityService / DataScope
    }
    class "catalog.service::GeoCatalogService" as GEO <<service>> {
      - GeoDepartmentRepository departments
      - GeoMunicipalityRepository municipalities
    }
    class "catalog.service::ReferenceCatalogService" as REF <<service>> {
      - ReferenceCatalogRepository catalogs
      - ReferenceOptionRepository options
    }
    class "catalog.service::GeoCatalogImporter" as GIMP <<runner>> {
      - GeoCountry/Department/MunicipalityRepository
    }
    class "catalog.service::LegacyCatalogImporter" as LIMP <<runner>> {
      - VaccineRepository vaccines
      - VaccineOptionRepository options
      - VaccineOptionTemplateRepository templates
    }
  }

  package "ui-mapping" {
    class "catalog.service::CatalogMapper" as CM <<component>> {
      + toVaccine / toGlobalOption / toTemplate
      + toInstitutionOption / toSuggestedOption / toInstitutionVaccine
    }
    class "catalog.service::CatalogRules" as CR <<final>> {
      + {static} requireValue(String)
      + {static} requireGlobalOptionType(String)
      + {static} requireTemplateType(String)
      + {static} requireLocalOptionType(String)
    }
  }

  package "entities" {
    class "catalog.entity::VaccineEntity" as VE <<entity>>
    class "catalog.entity::VaccineOptionEntity" as VO <<entity>>
    class "catalog.entity::VaccineOptionTemplateEntity" as VOT <<entity>>
    class "catalog.entity::InstitutionVaccineEntity" as IV <<entity>>
    class "catalog.entity::InstitutionVaccineOptionEntity" as IVO <<entity>>
    class "catalog.entity::ReferenceCatalogEntity" as RC <<entity>>
    class "catalog.entity::ReferenceOptionEntity" as RO <<entity>>
    class "catalog.entity::GeoCountryEntity" as GC <<entity>>
    class "catalog.entity::GeoDepartmentEntity" as GD <<entity>>
    class "catalog.entity::GeoMunicipalityEntity" as GM <<entity>>
    class "catalog.exception::OptimisticCatalogException" as OCE <<extends>>
  }

  class "catalog.dto" as CD <<group>> {
    VaccineRequest / VaccineResponse
    OptionRequest / OptionResponse
    CloneCatalogRequest / CloneCatalogResponse
    EffectiveCatalogResponse
    InstitutionVaccineResponse
    GeoDepartmentResponse / GeoMunicipalityResponse
    ReferenceCatalogResponse

@startuml diagrama-clases-solid
'
' Diagrama de Clases UML COMPLETO - Tu Vacuna PAI (backend services/api)
' Taller No. 3 (Principios de diseño)
' Cobertura: todo services/api/src/main/java/com/pai (SOLID + restante).
' Regenerado a partir de las firmas reales del codigo.
'
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam packageFontSize 13
skinparam packageTitleAlignment left
skinparam shadowing false
skinparam defaultFontSize 11
skinparam padding 4
skinparam ranksep 30
hide empty members
hide circle

top to bottom direction

' =====================================================================
' shared (security, application, util, exceptions)
' =====================================================================
package "shared" {

  package "security" {
    class "shared.security::SecurityConfig" as SC <<config>>
    class "shared.security::SecurityBeans" as SB <<config>>
    class "shared.security::AuthorizationService" as AUTHZ <<service>>
    class "shared.security::PermissionGuard" as PG <<service>> {
      - IdentityService identity
      + require(actorId, permission) : AuthorizedUser
    }
    class "shared.security::ActiveUserAuthenticationConverter" as AUTC <<service>>
    interface "org.springframework.core.convert.converter::Converter<Jwt, UsernamePasswordAuthenticationToken>" as CNV <<framework>>
  }

  package "application" {
    class "shared.application::IdempotencyCoordinator" as IC <<component>> {
      - AuditService audit
      - ProcessedOperationsService processedOperations
      + {record} WriteResult<T>(aggregateId, response)
      + {record} AuditContext(actorId, institutionId, action, resourceType)
      + <T> T execute(...) : cuerpo DIP
      + <T> T executeAudited(...)
    }
  }

  package "util" {
    class "shared.util::Strings" as STR <<final>> {
      + {static} blankToNull(String)
      + {static} trimToNull(String)
      + {static} <T> List<T> safe(List<T>)
    }
    class "shared.util::DocumentNormalizer" as DN <<final>> {
      + {static} normalize(String)
      + {static} normalizeType(String)
      + {static} isValidForType(String, String)
    }
  }

  package "exceptions" {
    class "shared.exceptions::RuntimeException" as RTE <<framework>>
    class "shared.exceptions::PermissionDeniedException" as PDE <<extends>>
    class "shared.exceptions::ScopeViolationException" as SVE <<extends>>
    class "shared.exceptions::UserNotFoundException" as UNFE <<extends>>
    class "shared.exceptions::UserNotActiveException" as UNAE <<extends>>
    class "shared.exceptions::RoleNotFoundException" as RNFE <<extends>>
    class "shared.exceptions::InstitutionNotFoundException" as INFE <<extends>>
    class "shared.exceptions::EmailAlreadyExistsException" as EAEE <<extends>>
    class "shared.exceptions::InstitutionCodeAlreadyExistsException" as ICAEE <<extends>>
    class "shared.exceptions::AuthUserProvisioningException" as AUPE <<extends>>
    class "shared.exceptions::ProvisioningPendingException" as PPE <<extends>>
    class "shared.exceptions::UncertainProvisioningException" as UPE <<extends>>
    class "shared.exceptions::GlobalExceptionHandler" as GEH <<advice>>
  }
}

' =====================================================================
' attentions
' =====================================================================
package "attentions (clinica)" {

  class "attentions.controller::AttentionController" as ATP {
    - AttentionService service
  }

  interface "attentions.service::VaccineCatalogPolicy" as VCP <<interface>> {
    + {record} DoseSelection ... (17 campos snapshot)
    + {record} ResolutionRequest ...
    + DoseSelection resolve(ResolutionRequest)
  }

  class "attentions.service::AttentionService" as AT <<service>> {
    - AttentionRepository attentions
    - AppliedDoseRepository doses
    - PatientRepository patients
    - VaccineCatalogPolicy catalogPolicy
    - IdentityService identity
    - DataScope dataScope
    - AuditService audit
    - IdempotencyCoordinator coordinator
    - AttentionMapper mapper
    - ObjectMapper objectMapper
    + create / get / update / complete / cancel
    + registerDose / cancelDose
  }

  class "attentions.service::AttentionMapper" as ATM <<component>> {
    + toResponse(AttentionEntity, doses) : AttentionResponse
    + toDoseResponse(AppliedDoseEntity) : AppliedDoseResponse
  }

  class "attentions.entity::AttentionEntity" as ATT <<entity>>
  class "attentions.entity::AppliedDoseEntity" as ADE <<entity>>
  class "attentions.exception::InvalidClinicalStateException" as ICSE <<extends>>
  class "attentions.exception::AttentionNotFoundException" as ANFE <<extends>>
  class "attentions.exception::DoseNotFoundException" as DNFE <<extends>>

  class "attentions.dto" as ATD <<group>> {
    CreateAttentionRequest
    UpdateAttentionRequest
    CancelAttentionRequest
    RegisterDoseRequest
    CancelDoseRequest
    AttentionResponse
    AppliedDoseResponse
  }
}

' =====================================================================
' patients
' =====================================================================
package "patients" {

  class "patients.controller::PatientController" as PP {
    - PatientService service
  }

  class "patients.service::PatientService" as PS <<service>> {
    - PatientRepository patients
    - PatientContactRepository contacts
    - PatientDemographicRepository demographics
    - PatientAddressRepository addresses
    - PatientGuardianRepository guardians
    - PatientMedicalHistoryRepository medicalHistories
    - PatientAffiliationRepository affiliations
    - PatientSpecialConditionRepository specialConditions
    - PatientUserConditionRepository userConditions
    - IdentityService / DataScope / AuditService
    - IdempotencyCoordinator coordinator
    - PatientMapper mapper
    + create / update* / get / list
  }

  class "patients.service::PatientMapper" as PM <<component>> {
    + toResponse(patient, demographic, contacts, addresses, guardians,
      medicalHistories, affiliation, specialConditions, userCondition)
  }

  class "patients.service::PatientMergeRequestService" as PMR <<service>> {
    - PatientMergeRequestRepository repository
  }

  class "patients.entity::PatientEntity" as PE <<entity>>
  class "patients.entity::PatientDemographicEntity" as PDe <<entity>>
  class "patients.entity::PatientContactEntity" as PCo <<entity>>
  class "patients.entity::PatientAddressEntity" as PAd <<entity>>
  class "patients.entity::PatientGuardianEntity" as PGu <<entity>>
  class "patients.entity::PatientMedicalHistoryEntity" as PMH <<entity>>
  class "patients.entity::PatientAffiliationEntity" as PAf <<entity>>
  class "patients.entity::PatientSpecialConditionEntity" as PSC <<entity>>
  class "patients.entity::PatientUserConditionEntity" as PUC <<entity>>
  class "patients.entity::PatientMergeRequestEntity" as PME <<entity>>
  class "patients.exception::PatientNotFoundException" as PNFE <<extends>>
  class "patients.exception::PatientAlreadyExistsException" as PAEE <<extends>>

  class "patients.dto" as PD <<group>> {
    CreatePatientRequest
    UpdatePatientIdentity/Contact/Demographics/MedicalHistoriesRequest
    PatientResponse
  }
}


' =====================================================================
package "synchronization" {
  class "synchronization.controller::SyncController" as SRC {
    - SyncPushService pushService
    - SyncPullService pullService
  }
  class "synchronization.service::SyncPushService" as SPU <<service>> {
    - PatientService patients
    - AttentionService attentions
    - PatientMergeRequestService mergeRequests
    - IdentityService / ProcessedOperationsService / ObjectMapper
  }
  class "synchronization.service::SyncPullService" as SPL <<service>> {
    - ProcessedOperationRepository repository
    - IdentityService / DataScope / ObjectMapper
  }
  class "synchronization.service::ProcessedOperationsService" as PES <<service>> {
    - ProcessedOperationRepository repository
  }
  class "synchronization.entity::ProcessedOperationEntity" as POENT <<entity>>
  class "synchronization.dto" as SYD <<group>> {
    SyncPushRequest / SyncPushResponse
    SyncPullResponse / SyncOperation / RejectedOperation
  }
}


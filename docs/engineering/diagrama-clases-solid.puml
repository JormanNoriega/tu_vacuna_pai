legend right
  == Tipos de relacion ==
  ==> composicion *-- (rombo lleno, parte inseparable)
  ==> agregacion o-- (rombo vacio, contiene)
  ==> herencia --|> (extends; repos -> JpaRepository, importer -> ApplicationRunner)
  ==> realizacion ..|> (implements; CSS -> VaccineCatalogPolicy)
  ==> dependencia ..> (usa: controller->service, service->mapper/repo)
  == SOLID aplicado ==
  = SRP -> mappers/rules separan conversion
  = DIP -> catalogo via VaccineCatalogPolicy
  = OCP -> IdempotencyCoordinator transversal
  = DRY -> helpers Shared y permisos canonicos
endlegend


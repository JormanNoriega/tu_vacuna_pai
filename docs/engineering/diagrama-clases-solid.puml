' =====================================================================
' identity
' =====================================================================
package "identity" {

  package "controllers" {
    class "identity.controller::IdentityController" as ID {
      - IdentityService identityService
    }
    class "identity.controller::AdminController" as ADM {
      - InstitutionService institutionService
      - UserService userService
      - UserProvisioningService userProvisioningService
      - ProvisioningReconciliationService reconciliationService
    }
  }

  package "services" {
    class "identity.service::IdentityService" as IS <<service>> {
      - UserRepository userRepository
      - InstitutionRepository institutionRepository
      + resolve(userId) : AuthorizedUser
      + me(userId) : MeResponse
    }
    class "identity.service::AuthorizedUser" as AU <<dominio>> {
      - id, email, fullName
      - InstitutionEntity institution
      - List<String> roles, permissions
      - accessToken
    }
    class "identity.service::DataScope" as DSc <<service>> {
      + currentScope(actor) : InstitutionScope
      + resolveInstitutionId(actor, requested) : UUID
      + requireSameInstitution(actor, target)
    }
    class "identity.service::InstitutionScope" as INS <<record>> {
      boolean unrestricted
      UUID institutionId
    }
    class "identity.service::UserService" as US <<service>> {
      - UserRepository / RoleRepository / UserRoleRepository
      - IdentityService / DataScope / IdentityMapper
      + listByInstitution / updateStatus / updateRoles
    }
    class "identity.service::UserProvisioningService" as UPS <<service>> {
      - PermissionGuard guard
      - InstitutionRepository / ProfessionRepository
      - AuthUserProvisioningClient authUserClient
      - ProvisioningOperationRepository
      - AuthUserLookupService / UserMirrorWriter / IdentityMapper
      + createInstitutionAdmin / createVaccinator / updateInstitutionStatus
    }
    class "identity.service::UserMirrorWriter" as UMW <<service>> {
      - UserRepository / RoleRepository / UserRoleRepository
      - ProvisioningOperationRepository / IdentityMapper
      + writeMirrorAndRoles(operation, roleCode)
    }
    class "identity.service::ProvisioningReconciliationService" as PRS <<service>> {
      - AuthUserLookupService
      - ProvisioningOperationRepository
      - UserMirrorWriter
    }
    class "identity.service::InstitutionService" as INSTS <<service>> {
      - InstitutionRepository institutionRepository
      - InstitutionVaccineService institutionVaccineService
    }
    class "identity.service::AuthUserLookupService" as ALK <<service>> {
      - JdbcTemplate jdbcTemplate
      + {record} AuthUserRecord / OrphanRecord
    }
    class "identity.service::AuthUserProvisioningClient" as AUPC <<interface>> {
      + createAuthUser(...) : UUID
      + deleteAuthUser(accessToken, userId)
      + findByEmail(...)
    }
    class "identity.service::SupabaseAuthUserClient" as SUP <<service>> {
      - RestClient restClient
    }
    class "identity.service::AuthUserProfile" as AUP <<record>>
  }

  package "mapeo-y-reglas" {
    class "identity.service::IdentityMapper" as IM <<component>> {
      - UserRepository userRepository
      + toUserResponse(entity) / (entity, status) / (operation)
    }
    class "identity.service::IdentityRules" as IR <<final>> {
      + {static} parseUserStatus(String)
      + {static} parseInstitutionStatus(String)
    }
    class "identity.service::IdentityPermissions" as IP <<final>> {
      + {static} INSTITUTION_WRITE : String
      + {static} USER_MANAGE : String
    }
  }

  package "entities" {
    class "identity.entity::UserEntity" as UE <<entity>>
    class "identity.entity::RoleEntity" as RE <<entity>>
    class "identity.entity::PermissionEntity" as PRE <<entity>>
    class "identity.entity::UserRoleEntity" as URE <<entity>>
    class "identity.entity::RolePermissionEntity" as RPE <<entity>>
    class "identity.entity::InstitutionEntity" as IE <<entity>>
    class "identity.entity::ProfessionEntity" as PROFE <<entity>>
    class "identity.entity::ProvisioningOperationEntity" as POE <<entity>>
    class "identity.entity::ProvisioningOperationStatus" as POS <<enum>>
  }

  class "identity.dto" as IDD <<group>> {
    MeResponse / UserResponse / InstitutionResponse
    CreateInstitutionAdmin/VaccinatorRequest
    CreateInstitutionRequest
    UpdateUserStatus/RolesRequest
    UpdateInstitutionStatus/ConfigRequest
    ProvisioningOperationResponse
    ReconciliationResultResponse
  }
}


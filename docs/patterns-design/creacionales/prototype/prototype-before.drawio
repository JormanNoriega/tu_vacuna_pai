        <mxCell id="1" parent="0" />

        <mxCell id="svc" value="InstitutionVaccineService" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="130" as="geometry" /></mxCell>
        <mxCell id="svc-e" value="+ enable(actorId, institutionId, vaccineId)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="svc"><mxGeometry height="40" width="330" y="26" as="geometry" /></mxCell>
        <mxCell id="svc-d" value="+ doClone(institutionId, actorId, includeDefaultConfig)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="svc"><mxGeometry height="40" width="330" y="66" as="geometry" /></mxCell>

        <mxCell id="tpl" value="VaccineOptionTemplateEntity&#10;(fuente: catalogo global)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="ent" value="InstitutionVaccineOptionEntity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="360" height="60" as="geometry" /></mxCell>

        <mxCell id="e-tpl" value="template.getFieldType(), getValue(), getDisplayName(), getSortOrder(), ..." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=8 8;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="tpl" target="ent"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e-enable" value="enable(): new InstitutionVaccineOptionEntity(id, institutionId, vaccineId, ...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="svc" target="ent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-clone" value="doClone(): new InstitutionVaccineOptionEntity(... idem, duplicado ...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.75;entryX=0;entryY=0.8;" edge="1" parent="1" source="svc" target="ent"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="SIN PROTOTYPE&#10;&#10;La misma copia campo-a-campo esta DUPLICADA:&#10;una vez en enable(...) y otra en doClone(...).&#10;No hay un clon unico reutilizable; cada metodo reconstruye el objeto leyendo el template." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="700" height="150" as="geometry" /></mxCell>

        <mxCell id="edge-s-merge" edge="1" parent="1" source="monolith-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="dep-merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-s-actor" edge="1" parent="1" source="monolith-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="dep-actor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cuadro de Notas de Problemas -->
        <mxCell id="note-problems" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F8CECC;strokeColor=#B85450;size=16;" value="&lt;b&gt;Problemas de Diseño (ANTES):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Violación SRP:&lt;/b&gt; SyncPushService orquesta lotes, valida dependencias, verifica idempotencia, evalúa seguridad y mapea 6 excepciones de dominio.&lt;br/&gt;• &lt;b&gt;Violación OCP:&lt;/b&gt; Agregar una regla (ej. reloj de dispositivo, IPS activa) obliga a modificar el bucle con más if, continue y acoplamientos.&lt;br/&gt;• &lt;b&gt;Alto Acoplamiento:&lt;/b&gt; Conoce múltiples servicios de infraestructura y dominio directamente en un solo método." vertex="1">
          <mxGeometry height="140" width="340" x="420" y="440" as="geometry" />
        </mxCell>
      </root>

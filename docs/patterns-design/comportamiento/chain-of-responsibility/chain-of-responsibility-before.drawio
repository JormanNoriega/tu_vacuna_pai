        <!-- Clase Monolítica: SyncPushService (Antes) -->
        <mxCell id="monolith-service" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;div&gt;SyncPushService (Monolito ANTES)&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="340" x="420" y="145" as="geometry" />
        </mxCell>
        <mxCell id="ms-attr" parent="monolith-service" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="&lt;div&gt;- identity: IdentityService&lt;/div&gt;&lt;div&gt;- mergeRequests: PatientMergeRequestService&lt;/div&gt;&lt;div&gt;- processedOperations: ProcessedOperationsPort&lt;/div&gt;&lt;div&gt;- handlers: Map&amp;lt;String, SyncCommandHandler&amp;gt;&lt;/div&gt;" xml:space="preserve" vertex="1">
          <mxGeometry height="68" width="340" y="34" as="geometry" />
        </mxCell>
        <mxCell id="ms-sep" parent="monolith-service" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" value="" vertex="1">
          <mxGeometry height="8" width="340" y="102" as="geometry" />
        </mxCell>
        <mxCell id="ms-meth" parent="monolith-service" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;+ push(actorId, request): SyncPushResponse&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;↳ bucle for cada operacion:&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1. if (!dependencias) -&amp;gt; continue&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2. if (idempotencia) -&amp;gt; continue&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;3. if (!handler) -&amp;gt; continue&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;4. if (!permisos) -&amp;gt; continue&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;5. try-catch 6 excepciones dominio&lt;/div&gt;&lt;div&gt;- dependencyRejection(op, outcomes): String&lt;/div&gt;&lt;div&gt;- reject(rejected, outcomes, ...): void&lt;/div&gt;" xml:space="preserve" vertex="1">
          <mxGeometry height="150" width="340" y="110" as="geometry" />
        </mxCell>


          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-s-handler" edge="1" parent="1" source="monolith-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=open;endFill=0;dashed=1;" target="dep-handler">

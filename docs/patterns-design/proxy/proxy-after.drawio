        <!-- Note of Benefits -->
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="PATRON ESTRUCTURAL: PROXY (PROTECTION PROXY)&#xa;&#xa;1. Subject (VaccineService): Define el contrato abstracto comun. CatalogController depende exclusivamente de esta interfaz (DIP).&#xa;2. Protection Proxy (VaccineSecurityProxy): Intercepta llamadas y valida permisos con PermissionGuard. Si el actor no cuenta con el permiso requerido, lanza PermissionDeniedException cortocircuitando la ejecucion sin tocar la logica de negocio ni la base de datos.&#xa;3. RealSubject (DefaultVaccineService): Maneja exclusivamente reglas del catalogo, optimismo y persistencia. Cero dependencias de autorizacion (SRP).&#xa;4. Inyeccion Transparente: El Proxy se anota con @Primary, por lo que Spring lo inyecta automaticamente en CatalogController sin alterar una sola linea del controlador." vertex="1">
          <mxGeometry height="200" width="880" x="50" y="530" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

# Plantilla de entorno para scripts/smoke-provisioning.ps1
# Copia a scripts/.env.smoke (gitignored) y completa tus valores locales.
# Nunca versiones credenciales reales.

# Supabase (proyecto actual). La URL y la anon key deben corresponder al mismo proyecto.
SUPABASE_URL=https://jfxkrznzhfvecaaixkjv.supabase.co
SUPABASE_ANON_KEY=pon_aqui_la_anon_publishable_key

# Admin que ejecuta el smoke. Debe tener USER_MANAGE (SUPER_ADMIN o ADMIN_INSTITUTION).
SMOKE_ADMIN_EMAIL=admin@pai.test
SMOKE_ADMIN_PASSWORD=pon_aqui_la_contrasena_real

# Base de la API (default si se omite: http://localhost:8080/api/v1)
API_BASE=http://localhost:8080/api/v1

# Opcional: URL de la BD para verificacion en BD + limpieza completa del recurso
# de prueba (requiere psql en el PATH). Si se omite, el smoke no verifica en BD
# y deja el recurso creado (el script indica como limpiarlo manualmente).
# PAI_SMOKE_DB_URL=postgresql://postgres:pass@host:5432/postgres?sslmode=require
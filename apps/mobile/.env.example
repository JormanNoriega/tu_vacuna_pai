# Variables de entorno para la app movil.
# Se pasan en compilacion/ejecucion con --dart-define, NO se leen de un .env.
#
# Ejemplo:
#   flutter run --dart-define=SUPABASE_URL=https://jfxkrznzhfvecaaixkjv.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJ... \
#               --dart-define=API_BASE_URL=http://localhost:8080/api/v1

# URL del proyecto Supabase (Auth + PostgreSQL).
SUPABASE_URL=https://jfxkrznzhfvecaaixkjv.supabase.co

# Clave publica de Supabase (publishable key, formato sb_publishable_...).
# Project Settings > API Keys. NO es la service_role key: nunca debe estar en la app.
# (La antigua clave anon sigue aceptandose como respaldo.)
SUPABASE_PUBLISHABLE_KEY=

# URL base del backend Spring (solo para /api/v1/me y futuros endpoints).
API_BASE_URL=http://localhost:8080/api/v1
# ===== Tu Vacuna PAI - variables de entorno de la API =====
# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# --- Servlet ---
SERVER_PORT=8080

# --- PostgreSQL (Supabase) ---
# Desde el panel de Supabase: Project Settings > Database > Connection string.
# El host directo db.<ref>.supabase.co es IPv6-only; usa el POOLER (IPv4):
#   aws-0-<region>.pooler.supabase.com (region del proyecto, ej. us-west-2)
#   Usuario: postgres.<project-ref>
# Modos: 5432 = session (recomendado para Flyway/dev), 6543 = transaction (prod).
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.jfxkrznzhfvecaaixkjv
# La contraseña de la base NO es la del panel web; es la del Database popup (Reset database password).
DB_PASSWORD=

# --- Supabase Auth (Resource Server) ---
SUPABASE_AUTH_ISSUER=https://jfxkrznzhfvecaaixkjv.supabase.co/auth/v1